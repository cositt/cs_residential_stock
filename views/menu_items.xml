<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="action_product_template_equilibrium" model="ir.actions.act_window">
            <field name="name">Productos Equilibrium</field>
            <field name="res_model">product.template</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="domain">[('cs_residential_supply_category', '!=', False)]</field>
            <field name="context">{'default_cs_residential_supply_category': 'food'}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Marque la categoría residencial en la ficha del producto (pestaña Inventario).
                </p>
            </field>
        </record>

        <menuitem
            id="menu_cs_residential_stock_products"
            name="Productos Equilibrium"
            parent="stock.menu_stock_inventory_control"
            action="action_product_template_equilibrium"
            sequence="25"
        />
    </data>
</odoo>
