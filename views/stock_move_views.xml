<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_picking_move_tree_cs_residential" model="ir.ui.view">
            <field name="name">stock.picking.move.list.equilibrium</field>
            <field name="model">stock.move</field>
            <field name="inherit_id" ref="stock.view_picking_move_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='product_id']" position="after">
                    <field name="cs_residential_category" optional="show"/>
                    <field name="cs_resident_id" optional="hide"/>
                    <field name="cs_cleaning_zone" optional="hide" invisible="cs_residential_category != 'cleaning'"/>
                </xpath>
            </field>
        </record>

        <record id="view_stock_move_operations_cs_residential" model="ir.ui.view">
            <field name="name">stock.move.operations.form.equilibrium</field>
            <field name="model">stock.move</field>
            <field name="inherit_id" ref="stock.view_stock_move_operations"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='product_qty']" position="after">
                    <group string="Equilibrium (centro residencial)" name="cs_residential_move_group">
                        <field name="cs_residential_category"/>
                        <field name="cs_resident_id"/>
                        <field name="cs_cleaning_zone" invisible="cs_residential_category != 'cleaning'"/>
                        <field name="cs_responsible_signature" widget="image" class="oe_avatar"/>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
