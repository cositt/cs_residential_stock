<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="product_template_form_cs_residential" model="ir.ui.view">
            <field name="name">product.template.form.equilibrium.residential</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="stock.view_template_property_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='inventory']/group" position="inside">
                    <group string="Equilibrium (centro residencial)" name="cs_residential_supply">
                        <field name="cs_residential_supply_category"/>
                    </group>
                </xpath>
            </field>
        </record>

        <record id="product_template_search_cs_residential" model="ir.ui.view">
            <field name="name">product.template.search.equilibrium.residential</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_search_view"/>
            <field name="arch" type="xml">
                <xpath expr="//search" position="inside">
                    <separator/>
                    <filter name="cs_residential_category_food" string="Equilibrium: Comida" domain="[('cs_residential_supply_category', '=', 'food')]"/>
                    <filter name="cs_residential_category_cleaning" string="Equilibrium: Limpieza" domain="[('cs_residential_supply_category', '=', 'cleaning')]"/>
                    <filter name="cs_residential_category_pharmacy" string="Equilibrium: Farmacia" domain="[('cs_residential_supply_category', '=', 'pharmacy')]"/>
                    <filter name="cs_residential_any" string="Equilibrium: clasificados" domain="[('cs_residential_supply_category', '!=', False)]"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
